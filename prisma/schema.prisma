// Vemporium — data model
// Money is ALWAYS stored in USD base (Decimal). Local currency is a display
// concern resolved at read time by the geo/currency engine. See src/lib/currency.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum Category {
  KURTA
  KURTI
  SAREE
  LEHENGA
  SHERWANI
  DUPATTA
  SALWAR
}

enum Fabric {
  SILK
  CHANDERI
  COTTON
  LINEN
  GEORGETTE
  CHIFFON
  VELVET
  BANARASI_BROCATTE
  RAW_SILK
}

enum Weave {
  HANDLOOM
  POWERLOOM
  JACQUARD
  KHADI
  TUSSAR
}

enum WorkType {
  ZARI
  ZARI_DOI
  EMBROIDERY
  CHIKANKARI
  PHULKARI
  KASUTI
  BLOCK_PRINT
  AJRAKH
  TAPA
  PLAIN
}

enum DrapingType {
  WRAPPED // saree, dupatta — falls from the waist, pleated front
  RIGID // sherwani, kurta — structured, fixed silhouette
  FLOWING // lehenga, sharara — wide flare, high volume
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique
  title         String
  description   String
  basePriceUsd  Decimal  @db.Decimal(10, 2)
  compareAtUsd  Decimal? @db.Decimal(10, 2)
  currency      String   @default("USD")

  category      Category
  fabric        Fabric
  weave         Weave
  workType      WorkType
  drapingType   DrapingType
  colourway     String // human readable, e.g. "Deep Maroon / Gold Zari"
  tags          String[]

  // 3D assets. A procedural fallback mesh ships in /public/models/procedural
  // so the fitting room works before any GLB is authored.
  modelAssetUrl  String?
  modelSourceUrl String?
  textureSetUrl  String?
  drapingProfile Json? // per-garment drape tuning (pleat count, flare, hem drop)

  careInstructions String?
  originCity       String? // e.g. "Varanasi" — surfaced for trust/traceability

  variants    ProductVariant[]
  orderItems  OrderItem[]
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, isPublished])
  @@index([fabric])
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sizeLabel   String // XS S M L XL XXL or "Custom"
  sizeCode    Int // ordinal, used for size recommendation ranking
  bustCm      Float?
  waistCm     Float?
  hipCm       Float?
  lengthCm    Float?
  shoulderCm  Float?
  chestCm     Float? // menswear

  colourHex  String? // per-variant colour, drives the 3D material
  stockSkuId String? @db.Uuid
  stock      Inventory?

  priceOverrideUsd Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([productId, sizeLabel, colourHex])
  @@index([productId, sizeCode])
}

// ---------------------------------------------------------------------------
// Avatars
// ---------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
  KID_BOY
  KID_GIRL
}

// NOTE: body measurements are sensitive personal data (GDPR Art.9).
// This model is intentionally self-hosted; never sync it to third-party
// analytics. Export/anonymisation lives in src/lib/privacy.ts.
model AvatarProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String  @default("My avatar")
  gender       Gender
  heightCm     Float
  weightKg     Float
  bustCm       Float? // women + kids
  chestCm      Float? // men
  waistCm      Float
  hipCm        Float
  skinToneHex  String
  hairStyleId  String?
  hairColorHex String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  emailVerified DateTime?
  passwordHash String? // null for OAuth-only accounts, always present for credentials
  name        String?
  image       String?
  countryCode String? // ISO 3166-1 alpha-2, drives the default currency
  locale      String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // GDPR: an avatar can be deleted while the account lives on, so erasure is
  // two independent rights. Deleting an avatar must NOT require closing the
  // account, and closing the account must cascade every avatar away.
  marketingOptIn Boolean @default(false)

  /// Bumped to invalidate every outstanding session for this user.
  ///
  /// Why this exists: Auth.js refuses to combine the Credentials provider with
  /// `session.strategy: "database"` (@auth/core assert.js), so a password login
  /// can ONLY work with JWT sessions — and a bare JWT cannot be revoked.
  ///
  /// This column is the revocation that the database-session table would have
  /// given us for free. The session callback re-reads the user on every request
  /// and drops the session if the version no longer matches, so "sign out
  /// everywhere" and account erasure both take effect immediately rather than
  /// at token expiry.
  sessionVersion Int @default(0)

  avatars  AvatarProfile[]
  orders   Order[]
  accounts Account[]
  sessions Session[]

  @@index([email])
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

// Standard Auth.js shapes. Kept even though we only use the credentials
// provider today: an OAuth provider later is a row insert, not a migration.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Database-backed sessions, not JWTs, and that is a deliberate choice:
// a stateless JWT cannot be revoked. Body measurements are GDPR Art. 9 data,
// and a shopper who deletes their data must be signed out everywhere
// immediately, not whenever the token happens to expire.
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Supply chain
// ---------------------------------------------------------------------------

enum SupplierStatus {
  ACTIVE
  PAUSED
  OFFBOARDED
}

model Supplier {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  city         String
  state        String
  contactName  String?
  whatsappE164 String // Twilio requires E.164, e.g. +919876543210
  email        String?
  status       SupplierStatus @default(ACTIVE)
  leadTimeDays Int @default(21)

  skus   Inventory[]
  orders PurchaseOrder[]

  createdAt DateTime @default(now())
}

enum StockStatus {
  IN_STOCK
  LOW
  OUT_OF_STOCK
  IN_PRODUCTION
  DISPATCHED
}

model Inventory {
  skuId            String @id @default(uuid()) @db.Uuid
  productVariantId String @unique @db.Uuid
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  stockLevel       Int
  reorderThreshold Int @default(10)
  reorderQuantity  Int @default(50)
  status           StockStatus @default(IN_STOCK)

  // Split across channels; an in-store sale decrements the same row.
  reservedOnline Int @default(0)
  reservedRetail Int @default(0)

  supplierId String? @db.Uuid
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  purchaseOrders PurchaseOrderLine[]
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  IN_PRODUCTION
  DISPATCHED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id        String @id @default(uuid()) @db.Uuid
  reference String @unique // e.g. "PO-2026-0001"
  supplierId String @db.Uuid
  supplier  Supplier @relation(fields: [supplierId], references: [id])

  status  PurchaseOrderStatus @default(DRAFT)
  trigger String // "THRESHOLD_BREACH" | "SELL_OUT" | "MANUAL"
  units   Int
  fabricSpec String?
  deliveryDeadline DateTime?

  dispatchedVia String[] // ["whatsapp", "email"]
  sentAt      DateTime?
  acknowledgedAt DateTime?

  lines    PurchaseOrderLine[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String @id @default(uuid()) @db.Uuid
  purchaseOrderId String @db.Uuid
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  skuId           String @db.Uuid
  inventory       Inventory @relation(fields: [skuId], references: [skuId])
  quantity        Int
  unitCostUsd     Decimal? @db.Decimal(10, 2)
}

// ---------------------------------------------------------------------------
// Commerce
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLING
  // Set when the supplier has been told to prepare the goods. Separate from
  // SHIPPED because "the workshop is working on it" and "it is with the
  // courier" are different facts an operator needs to distinguish.
  DISPATCHED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id        String  @id @default(uuid()) @db.Uuid
  reference String  @unique
  userId    String? @db.Uuid
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Guest checkout. Required when userId is null — an order with no owner and
  // no email could never be delivered or refunded.
  guestEmail String?

  status             OrderStatus @default(PENDING_PAYMENT)
  /// Set once, by the Stripe webhook, inside the guarded transition.
  paidAt             DateTime?
  currency           String // local currency actually charged
  fxRateAtOrder      Decimal @db.Decimal(12, 6)
  subtotalLocal      Decimal @db.Decimal(12, 2)
  dutiesLocal        Decimal @default(0) @db.Decimal(12, 2)
  taxLocal           Decimal @default(0) @db.Decimal(12, 2)
  shippingLocal      Decimal @default(0) @db.Decimal(12, 2)
  totalLocal         Decimal @db.Decimal(12, 2)
  destinationCountry String // ISO-2, drives the duty band
  paymentProvider    String? // stripe | kakaopay | klarna | paypay | paypal
  paymentRef         String?

  // --- Stripe readiness --------------------------------------------------
  // Unique so a webhook can never transition the same intent twice, and so a
  // replayed event is caught by the constraint rather than by hope.
  stripePaymentIntentId String? @unique
  // Client-supplied, stable across retries of the SAME checkout attempt. A
  // double-clicked "Place order" reuses the key and returns the original order
  // instead of creating a second one.
  idempotencyKey String? @unique

  /// SHA-256 of the one-time checkout capability token, returned to the client
  /// once at order creation.
  ///
  /// Exists because guest checkout has no session to authorise against. Without
  /// it, anyone could POST an orderId to /checkout/create-intent and pay for —
  /// or enumerate — somebody else's basket, since order ids are guessable UUIDs.
  /// Hashed so a database leak does not hand out the ability to act on open
  /// orders. High-entropy random input, so SHA-256 rather than bcrypt is the
  /// right KDF here.
  checkoutTokenHash String? @unique

  /// Immutable fitting snapshot.
  ///
  /// A foreign key to AvatarProfile is NOT enough: the shopper edits their
  /// measurements next month, and a return three months after that would be
  /// judged against the wrong body. This freezes what they were wearing the day
  /// they bought it.
  ///
  /// Data minimisation: measurements only, no skin tone or hairstyle. Those do
  /// not affect fit, and this column SURVIVES account erasure (see
  /// eraseAccount), so anything written here is data we keep permanently.
  fittingSnapshot Json?

  items     OrderItem[]
  /// Outbound supplier notifications, written inside the paid transition.
  dispatches DispatchOutbox[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@index([guestEmail])
}

model OrderItem {
  id             String  @id @default(uuid()) @db.Uuid
  orderId        String  @db.Uuid
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String  @db.Uuid
  product        Product @relation(fields: [productId], references: [id])
  variantLabel   String
  quantity       Int
  unitPriceLocal Decimal @db.Decimal(12, 2)
  lineTotalLocal Decimal @db.Decimal(12, 2)
}

// Idempotency ledger for inbound provider webhooks. Keeping the raw payload
// makes disputes and reconciliation possible later.
model WebhookEvent {
  id              String   @id @default(uuid()) @db.Uuid
  providerEventId String   @unique
  type            String
  payload         Json
  processedAt     DateTime @default(now())

  @@index([type])
}

/// Transactional outbox for supplier notifications.
///
/// Why this table exists: the obvious implementation sends the WhatsApp inside
/// the same transaction that marks the order PAID. That is wrong in both
/// directions — if the transaction rolls back after the send, a karigah has been
/// told to start work on an order that does not exist; if the send fails after
/// commit, the customer has paid and the workshop was never told.
///
/// So the transaction only records INTENT, and the message goes out afterwards.
/// If dispatch fails the row stays PENDING/FAILED and a retry sweep picks it up.
/// The order is never rolled back because a messaging provider was down.
model DispatchOutbox {
  id       String @id @default(uuid()) @db.Uuid
  orderId  String @db.Uuid
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// ORDER_ALERT (prepare this paid order) or REORDER_PO (bulk replenishment).
  kind String

  /// Built and frozen at enqueue time. A later product rename must not change
  /// what the supplier was actually asked to make.
  payload Json

  status     String    @default("PENDING") // PENDING | SENT | FAILED
  attempts   Int       @default(0)
  lastError  String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([status])
  @@index([orderId])
}
