# ---- Database ----------------------------------------------------------
# PostgreSQL (catalog, avatars, orders, inventory, AUTH). Supabase/Neon/RDS all work.
DATABASE_URL="postgresql://user:password@localhost:5432/vemporium?schema=public"

# ---- Auth --------------------------------------------------------------
# REQUIRED in production. Without it the app falls back to a dev secret that is
# published in this repo, which would let anyone forge session cookies.
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# ---- Cache -------------------------------------------------------------
# Redis holds the FX rate cache + geoip cache. Optional in local dev:
# the app falls back to an in-process TTL cache when REDIS_URL is absent.
REDIS_URL=""

# ---- Geo / FX ----------------------------------------------------------
# Used to enrich a raw IP when no edge geolocation header is present.
IPINFO_TOKEN=""
# Free key-less mid-market feed (https://frankfurter.app). Disable to use
# the bundled fallback table only.
FX_API_URL="https://api.frankfurter.app/latest?from=USD"

# ---- Payments ----------------------------------------------------------
# Server-side secret key. NEVER expose this to the browser. Without it,
# POST /api/checkout/create-intent returns 503 rather than failing mid-checkout.
STRIPE_SECRET_KEY=""
# Signing secret for inbound webhooks (Dashboard -> Developers -> Webhooks).
# If this is absent the webhook refuses EVERY delivery with 503. It has no
# dev-mode "accept anything" fallback, unlike SUPPLIER_DISPATCH_SECRET below:
# an unauthenticated payment webhook is a free order-press.
# Test with:  stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Publishable key, safe for the client, for Stripe Elements.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Background jobs ----------------------------------------------------
# Bearer token for /api/cron/*. REQUIRED in production — this endpoint sends
# WhatsApp messages from our Twilio account to our suppliers, so an unprotected
# worker lets anyone with the URL message them.
# Vercel Cron sends this automatically when set in the dashboard.
# Generate with:  openssl rand -base64 32
CRON_SECRET=""

# ---- Supplier dispatch --------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
SUPPLIER_DISPATCH_SECRET="dev-secret-change-me"
RESEND_API_KEY=""
DISPATCH_FROM_EMAIL="dispatch@vemporium.com"

# ---- Storage (3D models, textures) -------------------------------------
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="vemporium-models"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
CDN_BASE_URL="https://cdn.vemporium.com"
