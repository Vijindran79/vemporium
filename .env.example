# ---- Database ----------------------------------------------------------
# PostgreSQL (catalog, avatars, orders, inventory). Supabase/Neon/RDS all work.
DATABASE_URL="postgresql://user:password@localhost:5432/vemporium?schema=public"

# ---- Cache -------------------------------------------------------------
# Redis holds the FX rate cache + geoip cache. Optional in local dev:
# the app falls back to an in-process TTL cache when REDIS_URL is absent.
REDIS_URL=""

# ---- Geo / FX ----------------------------------------------------------
# Used to enrich a raw IP when no edge geolocation header is present.
IPINFO_TOKEN=""
# Free key-less mid-market feed (https://frankfurter.app). Disable to use
# the bundled fallback table only.
FX_API_URL="https://api.frankfurter.app/latest?from=USD"

# ---- Payments ----------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---- Supplier dispatch --------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
SUPPLIER_DISPATCH_SECRET="dev-secret-change-me"
RESEND_API_KEY=""
DISPATCH_FROM_EMAIL="dispatch@vemporium.com"

# ---- Storage (3D models, textures) -------------------------------------
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="vemporium-models"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
CDN_BASE_URL="https://cdn.vemporium.com"
